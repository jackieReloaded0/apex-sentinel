# -----------------------------------------------------------------------------
# Apex-Sentinel 環境変数設定サンプル (.env.example)
# 本番環境 (Cloud Run) では GCP Secret Manager から注入されます。
# ローカル開発では、このファイルをコピーして .env を作成してください。
# -----------------------------------------------------------------------------

# Django 設定
DEBUG=True
SECRET_KEY=local-dev-dummy-secret-key-replace-in-production
ALLOWED_HOSTS=*

# データベース設定 (Neon Serverless PostgreSQL)
# 未設定の場合は自動的にローカルの db.sqlite3 にフォールバックします。
# 形式: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL=

# Oracle APEX ORDS ヘルスチェック設定
APEX_HEALTH_URL=https://.../ords/.../v1/health

# Google Cloud 設定 (Firestore)
# ローカルで gcloud auth application-default login している場合は自動認識されます。
GOOGLE_CLOUD_PROJECT=

